server {
  listen 80;
  root /usr/share/nginx/html;

  # history mode: unknown paths go back to the app
  location / {
    try_files $uri $uri/ /index.html;
  }

  # relay to TMDB, the key is added here so it never reaches the browser
  location /tmdb/ {
    rewrite ^/tmdb/(.*)$ /3/$1?api_key=${TMDB_KEY} break;
    proxy_pass https://api.themoviedb.org;
    proxy_set_header Host api.themoviedb.org;
    proxy_ssl_server_name on;
  }
}
